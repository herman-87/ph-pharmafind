<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-role-table" author="codex">
        <createTable tableName="t_role">
            <column name="c_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_t_role"/>
            </column>
            <column name="c_name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_t_role_c_name"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-user-table" author="codex">
        <createTable tableName="t_user">
            <column name="c_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_t_user"/>
            </column>
            <column name="c_created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="c_updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="c_username" type="VARCHAR(120)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_t_user_c_username"/>
            </column>
            <column name="c_email" type="VARCHAR(190)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_t_user_c_email"/>
            </column>
            <column name="c_password" type="VARCHAR(255)"/>
            <column name="c_provider" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="c_provider_id" type="VARCHAR(190)"/>
            <column name="c_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="c_account_non_expired" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="c_account_non_locked" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="c_credentials_non_expired" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="c_email_verified" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="t_user" indexName="idx_t_user_c_provider_c_provider_id">
            <column name="c_provider"/>
            <column name="c_provider_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-user-role-table" author="codex">
        <createTable tableName="t_user_role">
            <column name="c_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="c_role_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="t_user_role"
                       columnNames="c_user_id, c_role_id"
                       constraintName="pk_t_user_role"/>

        <addForeignKeyConstraint baseTableName="t_user_role"
                                 baseColumnNames="c_user_id"
                                 constraintName="fk_t_user_role_user"
                                 referencedTableName="t_user"
                                 referencedColumnNames="c_id"/>

        <addForeignKeyConstraint baseTableName="t_user_role"
                                 baseColumnNames="c_role_id"
                                 constraintName="fk_t_user_role_role"
                                 referencedTableName="t_role"
                                 referencedColumnNames="c_id"/>
    </changeSet>

    <changeSet id="004-create-user-scope-table" author="codex">
        <createTable tableName="t_user_scope">
            <column name="c_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="c_scope" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="t_user_scope"
                       columnNames="c_user_id, c_scope"
                       constraintName="pk_t_user_scope"/>

        <addForeignKeyConstraint baseTableName="t_user_scope"
                                 baseColumnNames="c_user_id"
                                 constraintName="fk_t_user_scope_user"
                                 referencedTableName="t_user"
                                 referencedColumnNames="c_id"/>
    </changeSet>

</databaseChangeLog>
